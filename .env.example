# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=

# AI 가이드: Gemini 또는 Claude 중 키가 있는 쪽으로 답합니다 (둘 다 있으면 AI_PROVIDER 로 고름)
# ⚠ 값 뒤에 설명(#)을 붙이지 마세요. 한 줄에 "이름=키" 만 쓰세요. 키는 절대 GitHub·카톡 공개방에 올리지 마세요.
# Gemini 키: https://aistudio.google.com/apikey (무료로 발급)
GEMINI_API_KEY=
# 모델 이름을 바꾸고 싶을 때만 (Google AI Studio 의 모델 목록에서 확인)
# GEMINI_MODEL=gemini-3.5-flash
# Claude 키 (강사가 나눠 준 키)
ANTHROPIC_API_KEY=
# gemini | anthropic | auto  (auto: 키가 있는 쪽, 둘 다 있으면 Gemini 먼저)
# AI_PROVIDER=auto

# 비짓제주 관광정보 API 키 (사진이 없는 해변의 사진을 채움, 서버 전용)
VISITJEJU_API_KEY=
