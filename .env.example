# =====================================================================
# 제주 레저 활동 도구 - 환경 변수
# 이 파일을 복사해 이름을 .env 로 바꾼 뒤 값을 채우세요.
# .env 파일은 절대 공유하거나 GitHub에 올리지 마세요.
# =====================================================================

# ---------------------------------------------------------------------
# [공통] 공공데이터포털 인증키
#  - data.go.kr 로그인 > 마이페이지 > 데이터활용 > 인증키 > "일반 인증키(Decoding)"
#  - 키는 계정당 1개이며, 아래 API마다 "활용신청"을 해야 그 API에 쓸 수 있습니다.
#    (국립해양조사원 API는 개발계정 자동승인, 일 10,000건)
# ---------------------------------------------------------------------
DATA_GO_KR_KEY=

# 한국관광공사 TourAPI (해변·맛집·카페·관광지). 비워 두면 DATA_GO_KR_KEY를 씁니다.
#  ※ 공공데이터포털에서 '한국관광공사_국문 관광정보 서비스' 활용신청 필요
TOUR_API_KEY=

# ---------------------------------------------------------------------
# 1. 서핑·해양 상황 (실시간 오픈API, 핵심)
# ---------------------------------------------------------------------

# 국립해양조사원_서핑지수 조회 (data.go.kr/data/15142490)
#  서핑 스팟별 5단계 서핑지수와 점수 (파고·파주기·풍속·수온 반영)
#  ※ 요청주소는 활용신청 후 상세페이지의 "요청주소"를 복사해 넣으세요.
KHOA_SURFING_URL=

# 국립해양조사원_해수욕장 정보 (data.go.kr/data/15099707, LINK형)
#  해수욕장 관측소의 조위·파고·수온·풍향·풍속 실측값
#  ※ 기관 링크형 API라 요청주소를 상세페이지에서 확인해 넣으세요.
KHOA_BEACH_OBS_URL=

# 기상청_전국 해수욕장 날씨 조회서비스 (data.go.kr/data/15102239)
#  해수욕장 약 330곳 초단기·단기예보, 파고, 수온, 조석, 일출·일몰
#  필수 파라미터: serviceKey, dataType=JSON, beach_num(해수욕장 번호)
KMA_BEACH_BASE_URL=https://apis.data.go.kr/1360000/BeachInfoservice

# 국립해양조사원_바다여행지수 조회 (data.go.kr/data/15142491)
#  섬·요트·여객선 여행 적합도 5단계, 7일 예보
#  필수 파라미터: serviceKey, type=json / 선택: placeCode, reqDate
KHOA_SEATRIP_BASE_URL=https://apis.data.go.kr/1192136/fcstSeaTripv2

# ---------------------------------------------------------------------
# 2. 해변 안전 (서핑할 때 함께 쓰면 좋은 API)
# ---------------------------------------------------------------------

# 국립해양조사원_이안류 지수 조회 (data.go.kr/data/15156028)
#  주요 해수욕장 이안류 위험도 4단계 (관심·주의·경계·위험)
#  ※ 요청주소는 상세페이지에서 확인해 넣으세요.
KHOA_RIPCURRENT_URL=

# 국립해양조사원_해수욕지수 조회 (data.go.kr/data/15142484)
#  해수욕 적합도 5단계
#  ※ 요청주소는 상세페이지에서 확인해 넣으세요.
KHOA_SWIM_URL=

# 생활해양예보지수 지점 목록 (data.go.kr/data/15145389, CSV 파일)
#  위 지수 API들이 제공되는 지점 143곳 (지수 코드명, 경도, 위도, 권역, 지역명, 주소)
#  내려받은 CSV를 이 폴더의 data/ 안에 넣고 파일 경로를 적으세요.
KHOA_INDEX_POINTS_CSV=data/생활해양예보지수_지점목록.csv

# ---------------------------------------------------------------------
# 3. 주변 장소 (맛집·카페·관광지·샤워장) - 카카오 API 대체
# ---------------------------------------------------------------------
# 맛집·카페·관광지: 한국관광공사 TourAPI 위치기반 조회 (위 TOUR_API_KEY 사용)
#   https://apis.data.go.kr/B551011/KorService2/locationBasedList2
# 공용샤워실: OpenStreetMap Overpass API (키 불필요)
#   https://overpass-api.de/api/interpreter
# 지도: Leaflet + OpenStreetMap (키 불필요)
